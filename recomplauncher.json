{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Resistance: Fall of Man",
  "repo": "miroslavdanutalexandru-alt/Resistance-Fall-of-Man-Recomp",
  "game": {
    "kind": "iso_or_folder",
    "label": "Your own copy of Resistance: Fall of Man, US disc BCUS98107, version 1.00: its disc image (.iso), or its folder with PS3_GAME in it (as RPCS3 uses). Other regions and patched versions don't work yet.",
    "check": {
      "iso9660": "PS3_DISC.SFB",
      "file": "PS3_DISC.SFB"
    }
  },
  "start": {
    "program": [
      "Launcher.exe"
    ],
    "args": [
      "--play"
    ]
  },
  "prepare": {
    "program": [
      "Setup.exe"
    ],
    "args": [
      "--prepare",
      "--game",
      "{game}"
    ],
    "label": "Building the game for your PC (the first time takes 10-30 minutes; Windows may ask once to install the free build tools)",
    "timeout": 14400
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/settings.ini"
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "display",
      "label": "Display mode",
      "help": "Borderless fills the screen and Alt+Tabs instantly.",
      "choices": [
        {
          "label": "Borderless",
          "set": {
            "display": "borderless"
          }
        },
        {
          "label": "Windowed",
          "set": {
            "display": "windowed"
          }
        }
      ],
      "defaults": {
        "display": "borderless"
      }
    },
    {
      "id": "window",
      "label": "Window size",
      "help": "The size of the game's window in Windowed mode.",
      "choices": [
        {
          "label": "1280 x 720",
          "set": {
            "window": "1280x720"
          }
        },
        {
          "label": "1600 x 900",
          "set": {
            "window": "1600x900"
          }
        },
        {
          "label": "1920 x 1080",
          "set": {
            "window": "1920x1080"
          }
        },
        {
          "label": "2560 x 1440",
          "set": {
            "window": "2560x1440"
          }
        },
        {
          "label": "3840 x 2160",
          "set": {
            "window": "3840x2160"
          }
        }
      ],
      "defaults": {
        "window": "1920x1080"
      },
      "when": {
        "display": "windowed"
      }
    },
    {
      "id": "fps",
      "label": "Frame rate limit",
      "help": "The PS3 game runs at 30. Higher limits play smoother without playing faster.",
      "choices": [
        {
          "label": "30 (PS3 original)",
          "set": {
            "fps": "30"
          }
        },
        {
          "label": "60",
          "set": {
            "fps": "60"
          }
        },
        {
          "label": "90",
          "set": {
            "fps": "90"
          }
        },
        {
          "label": "120",
          "set": {
            "fps": "120"
          }
        },
        {
          "label": "144",
          "set": {
            "fps": "144"
          }
        },
        {
          "label": "165",
          "set": {
            "fps": "165"
          }
        },
        {
          "label": "Just under refresh (G-Sync / FreeSync)",
          "set": {
            "fps": "vrr"
          }
        },
        {
          "label": "Unlimited",
          "set": {
            "fps": "0"
          }
        }
      ],
      "defaults": {
        "fps": "60"
      }
    },
    {
      "id": "vsync",
      "label": "VSync",
      "help": "Off is smoothest on G-Sync / FreeSync screens. Every refresh removes tearing on others.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "vsync": "0"
          }
        },
        {
          "label": "Every refresh",
          "set": {
            "vsync": "1"
          }
        },
        {
          "label": "Every 2nd refresh",
          "set": {
            "vsync": "2"
          }
        }
      ],
      "defaults": {
        "vsync": "0"
      }
    },
    {
      "id": "res",
      "label": "Render resolution",
      "help": "What the game draws at. Higher is sharper but costs GPU time.",
      "choices": [
        {
          "label": "1280 x 720 (PS3 original)",
          "set": {
            "res": "1"
          }
        },
        {
          "label": "1920 x 1080",
          "set": {
            "res": "1.5"
          }
        },
        {
          "label": "2560 x 1440",
          "set": {
            "res": "2"
          }
        },
        {
          "label": "3200 x 1800",
          "set": {
            "res": "2.5"
          }
        },
        {
          "label": "3840 x 2160",
          "set": {
            "res": "3"
          }
        }
      ],
      "defaults": {
        "res": "2"
      }
    },
    {
      "id": "aa",
      "label": "Anti-aliasing",
      "help": "Smooths jagged edges. DLSS needs a GeForce RTX card. FSR and XeSS work on any card.",
      "choices": [
        {
          "label": "Off (PS3 original)",
          "set": {
            "fsr": "0"
          }
        },
        {
          "label": "AMD FSR 3.1",
          "set": {
            "fsr": "1"
          }
        },
        {
          "label": "NVIDIA DLSS / DLAA",
          "set": {
            "fsr": "2"
          }
        },
        {
          "label": "Intel XeSS",
          "set": {
            "fsr": "3"
          }
        }
      ],
      "defaults": {
        "fsr": "0"
      }
    },
    {
      "id": "upscale",
      "label": "Upscaling",
      "help": "With an anti-aliasing mode on: draws the scene smaller and upscales it. Much faster.",
      "choices": [
        {
          "label": "Native",
          "set": {
            "upscale": "1"
          }
        },
        {
          "label": "Quality",
          "set": {
            "upscale": "0.667"
          }
        },
        {
          "label": "Balanced",
          "set": {
            "upscale": "0.58"
          }
        },
        {
          "label": "Performance",
          "set": {
            "upscale": "0.5"
          }
        },
        {
          "label": "Ultra Performance",
          "set": {
            "upscale": "0.333"
          }
        }
      ],
      "defaults": {
        "upscale": "1"
      }
    },
    {
      "id": "aniso",
      "label": "Texture filtering",
      "help": "Keeps floors and walls sharp at an angle. 16x costs almost nothing.",
      "choices": [
        {
          "label": "Trilinear (PS3 original)",
          "set": {
            "aniso": "0"
          }
        },
        {
          "label": "2x",
          "set": {
            "aniso": "2"
          }
        },
        {
          "label": "4x",
          "set": {
            "aniso": "4"
          }
        },
        {
          "label": "8x",
          "set": {
            "aniso": "8"
          }
        },
        {
          "label": "16x",
          "set": {
            "aniso": "16"
          }
        }
      ],
      "defaults": {
        "aniso": "16"
      }
    },
    {
      "id": "sharpen",
      "label": "Sharpening",
      "help": "Counteracts the softness of scaling and anti-aliasing.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "sharpen": "0"
          }
        },
        {
          "label": "Low",
          "set": {
            "sharpen": "0.25"
          }
        },
        {
          "label": "Medium",
          "set": {
            "sharpen": "0.5"
          }
        },
        {
          "label": "High",
          "set": {
            "sharpen": "0.8"
          }
        }
      ],
      "defaults": {
        "sharpen": "0.25"
      }
    },
    {
      "id": "padglyphs",
      "label": "Button prompts",
      "help": "Which controller's buttons the game shows.",
      "choices": [
        {
          "label": "Auto",
          "set": {
            "padglyphs": ""
          }
        },
        {
          "label": "Xbox",
          "set": {
            "padglyphs": "xbox"
          }
        },
        {
          "label": "PlayStation",
          "set": {
            "padglyphs": "ps"
          }
        }
      ],
      "defaults": {
        "padglyphs": ""
      }
    }
  ],
  "saves": [
    "{install}/gamedata/dev_hdd0/home/00000001/savedata",
    "{home}/Saved Games/Resistance Fall of Man/dev_hdd0/home/00000001/savedata",
    "{install}/settings.ini",
    "{install}/controls.txt"
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/gamedata/dev_hdd0/home/00000001/savedata",
        "if": "{install}/portable.txt"
      },
      {
        "path": "{home}/Saved Games/Resistance Fall of Man/dev_hdd0/home/00000001/savedata"
      }
    ],
    "logs": [
      {
        "path": "{install}/logs"
      }
    ]
  },
  "actions": [
    {
      "id": "saves",
      "label": "Saves",
      "help": "Your saved games.",
      "open": "saves"
    },
    {
      "id": "logs",
      "label": "Logs",
      "help": "Logs to attach when you report a problem.",
      "open": "logs"
    }
  ],
  "exit_codes": {
    "3": "The game isn't built yet. Run its setup again from the game's page.",
    "4": "The game's start script (run.bat) couldn't start. Reinstall the game, or report it with the logs folder."
  }
}
