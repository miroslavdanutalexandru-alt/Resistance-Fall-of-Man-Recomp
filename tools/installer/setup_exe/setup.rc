// Setup.exe resources: the port's icon, the manifest and version info.
#include <winres.h>

1 ICON "..\\..\\..\\project\\launcher.ico"
1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,3,0
 PRODUCTVERSION 0,2,3,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Resistance PC port project (open source)"
            VALUE "FileDescription", "Resistance PC port setup (builds the port from your own game copy)"
            VALUE "FileVersion", "0.2.3"
            VALUE "InternalName", "Setup"
            VALUE "OriginalFilename", "Setup.exe"
            VALUE "ProductName", "Resistance PC port"
            VALUE "ProductVersion", "0.2.3"
            VALUE "Comments", "Source: tools\\installer\\setup_exe\\setup.cpp"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
