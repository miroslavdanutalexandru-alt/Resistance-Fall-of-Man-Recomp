# CMake toolchain file: builds the Windows program on Linux (build_linux.sh, README "Linux / Steam Deck").
# clang-cl + lld-link + llvm-rc from LLVM, and Microsoft's C runtime + Windows SDK downloaded by xwin
# (tools_cache/msvc_linux, made by setup_linux.sh). The result is the same Windows .exe a Windows build makes;
# it runs under Proton / Wine. Not used on Windows (build.bat).
#
#   PORT_XWIN_DIR  the xwin "splat" folder (default: <port>/tools_cache/msvc_linux)
#   PORT_LLVM_BIN  folder of clang-cl / lld-link / llvm-rc (default: searched on PATH and in /usr/lib/llvm-NN/bin)
# Both can be given as -D options or as environment variables.

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 10.0)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

# try_compile projects read this file again with a fresh cache: hand the settings over through the environment
if(NOT PORT_XWIN_DIR)
    if(DEFINED ENV{PORT_XWIN_DIR} AND NOT "$ENV{PORT_XWIN_DIR}" STREQUAL "")
        set(PORT_XWIN_DIR "$ENV{PORT_XWIN_DIR}")
    else()
        get_filename_component(PORT_XWIN_DIR "${CMAKE_CURRENT_LIST_DIR}/../../tools_cache/msvc_linux" ABSOLUTE)
    endif()
endif()
if(NOT PORT_LLVM_BIN AND DEFINED ENV{PORT_LLVM_BIN})
    set(PORT_LLVM_BIN "$ENV{PORT_LLVM_BIN}")
endif()
set(ENV{PORT_XWIN_DIR} "${PORT_XWIN_DIR}")
set(ENV{PORT_LLVM_BIN} "${PORT_LLVM_BIN}")

if(NOT EXISTS "${PORT_XWIN_DIR}/crt/include/vcruntime.h" OR NOT EXISTS "${PORT_XWIN_DIR}/sdk/include/um/windows.h")
    message(FATAL_ERROR "The Microsoft C runtime and Windows SDK were not found in ${PORT_XWIN_DIR} - run ./setup_linux.sh")
endif()

set(_hints "")
if(PORT_LLVM_BIN)
    list(APPEND _hints "${PORT_LLVM_BIN}")
endif()
file(GLOB _distro_llvm LIST_DIRECTORIES true "/usr/lib/llvm-*/bin" "/usr/lib64/llvm*/bin")
list(SORT _distro_llvm COMPARE NATURAL ORDER DESCENDING)
list(APPEND _hints ${_distro_llvm})
foreach(_t clang-cl lld-link llvm-rc llvm-lib llvm-mt)
    string(MAKE_C_IDENTIFIER "PORT_${_t}" _v)
    if(PORT_LLVM_BIN)
        find_program(${_v} NAMES ${_t} HINTS ${_hints} NO_DEFAULT_PATH)
    endif()
    find_program(${_v} NAMES ${_t} HINTS ${_hints})
endforeach()
if(NOT PORT_clang_cl OR NOT PORT_lld_link OR NOT PORT_llvm_rc OR NOT PORT_llvm_lib)
    message(FATAL_ERROR "clang-cl, lld-link, llvm-rc and llvm-lib (LLVM) are needed; set PORT_LLVM_BIN to their folder")
endif()

set(CMAKE_C_COMPILER   "${PORT_clang_cl}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${PORT_clang_cl}" CACHE FILEPATH "" FORCE)
set(CMAKE_LINKER       "${PORT_lld_link}" CACHE FILEPATH "" FORCE)
set(CMAKE_AR           "${PORT_llvm_lib}" CACHE FILEPATH "" FORCE)
set(CMAKE_RC_COMPILER  "${PORT_llvm_rc}"  CACHE FILEPATH "" FORCE)
if(PORT_llvm_mt)
    set(CMAKE_MT "${PORT_llvm_mt}" CACHE FILEPATH "" FORCE)
endif()
set(CMAKE_C_COMPILER_TARGET   x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)

set(_x "${PORT_XWIN_DIR}")
set(_inc "${_x}/crt/include" "${_x}/sdk/include/ucrt" "${_x}/sdk/include/um" "${_x}/sdk/include/shared" "${_x}/sdk/include/winrt")
if(EXISTS "${_x}/sdk/include/cppwinrt")
    list(APPEND _inc "${_x}/sdk/include/cppwinrt")
endif()
set(_cflags "")
set(_rcflags "")
foreach(_d IN LISTS _inc)
    string(APPEND _cflags " /imsvc \"${_d}\"")
    string(APPEND _rcflags " -I \"${_d}\"")
endforeach()
set(_arch x86_64)
if(NOT EXISTS "${_x}/sdk/lib/um/x86_64" AND EXISTS "${_x}/sdk/lib/um/x64")
    set(_arch x64)
endif()
set(_lflags "/libpath:\"${_x}/crt/lib/${_arch}\" /libpath:\"${_x}/sdk/lib/um/${_arch}\" /libpath:\"${_x}/sdk/lib/ucrt/${_arch}\"")

set(CMAKE_C_FLAGS_INIT   "${_cflags}")
set(CMAKE_CXX_FLAGS_INIT "${_cflags}")
set(CMAKE_RC_FLAGS_INIT  "${_rcflags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT    "${_lflags}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_lflags}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_lflags}")
