# Nothing from the game is ever committed: these are all produced on the
# player's PC from their own copy by Setup.bat.
/gamefiles/
/game/
/gamedata/
/recompiled/
/recompiled_game/
/project/spu/*/
/project/spu/jobmods_register.c
/tools/key_vault.cpp
/tools/ffmpeg_bin/
/tools/dlss/
/tools/streamline/
/tools/ffx_bin/amd_fidelityfx_framegeneration_dx12.dll
/tools/ffx_bin/*.download
/shadercache/

# build output / runtime files
/build/
/build_game/
/build_regen/
/logs/
/rsxcap/
/Launcher.exe
/HDUIPack.exe
/settings.bat
/settings.ini
*.obj
*.pdb
*.ilk
__pycache__/

# installer output and test builds
/dist/
/build_dist/

# Generated and local-only: every build_* tree (test, profile and per-feature builds), the XeSS SDK that
# Setup downloads, scratch work and run-time folders
/build_*/
/build_*.log
/tools/xess/
/scratch/
/lle/
/cache/
/screenshots/
/mods/
/portable.txt
*.bak_*
/logs_build*.txt
/tools/installer/setup_exe/obj/

# downloaded by build.bat (tools\get_shaderscan.ps1) from the shaderscan repo's pinned release
/tools/shaderscan.exe
/tools/shaderscan.exe.download
# local copies of earlier builds
/backup_build_*/

# per-user online settings written by the launcher's Multiplayer page
/net_hosts.txt
/online.txt
/online_id.txt

# Setup.exe is attached to the GitHub release, not committed
/Setup.exe
# build tools Setup put into this folder (portable mode) and the list of what it installed
/tools_cache/
/scratch/RSXFIFOCommands*.pdf
# HD UI pack (HDUIPack.exe, built from project\hd_ui_pack.cpp): texture dumps and the upscaler/models downloaded on the user's PC
/texdump/
/tools/upscaler/
# PGO: pgo\<rN>.profdata is committed (build.bat uses it); training output and build stamps stay local
/pgo/raw/
/pgo/run_*/
/pgo/*.profraw
/pgo/*.sha256
# PGO raw profiles anywhere (training runs write *.profraw next to the exe)
*.profraw
/pgo/raw*/
# superseded developer PGO helper (scripts\pgo_*.ps1 + tools\pgo_train.bat replace it)
/build_pgo.bat
# per-save backups, crash-report staging, QA / replay run output: user data, never committed
/saves_backup/
/crash_report_work/
/tools/qa/runs/
/tools/replay/
# logs and fall-detection dumps outside /logs/ (nothing tracked is a .log)
*.log
fall_*.bin
# installer leftovers in a dev checkout (Inno Setup's uninstaller, the RFoMSwitch.exe it installs; build_installer.ps1 takes
# RFoMSwitch.exe from build_dist\ or build\): never shipped from the root
/unins*.dat
/unins*.exe
/RFoMSwitch.exe

# Online account (PORT_ONLINE): holds the player's password
/online.ini
